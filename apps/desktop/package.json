{
  "name": "@privanote/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Privanote desktop application",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "electron .",
    "dev:renderer": "vite",
    "build": "vite build",
    "dist": "npm run build --workspace @privanote/backend && npm run build && electron-builder install-app-deps && electron-builder --config electron-builder.yml --dir && npm rebuild better-sqlite3",
    "smoke:startup": "node scripts/smoke/startup.mjs",
    "smoke:package-launch": "node scripts/smoke/package-launch.mjs",
    "start": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@privanote/backend": "file:../backend",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.0",
    "electron": "28.3.3",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^4.4.0",
    "vitest": "^3.2.4"
  }
}
